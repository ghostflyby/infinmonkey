{
  "nodeModulesDir": "none",
  "fmt": {
    "lineWidth": 100,
    "exclude": ["apple", ".zcode"]
  },
  "lint": {
    "exclude": ["apple", ".zcode"],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-window",
        "no-window-prefix"
      ]
    },
    "plugins": [
      "packages/tools/lint-plugin.ts"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "webextension-polyfill": "npm:webextension-polyfill@0.12.0",
    "monaco-editor": "npm:monaco-editor@0.57.0",
    "monaco-editor/editor/editor.api": "npm:monaco-editor@0.57.0/editor/editor.api",
    "monaco-editor/editor/editor.worker": "./.monaco-esm/vs/editor/editor.worker.js",
    "monaco-editor/definitions/javascript/register": "./.monaco-esm/vs/languages/definitions/javascript/register.js",
    "monaco-editor/definitions/css/register": "./.monaco-esm/vs/languages/definitions/css/register.js",
    "monaco-editor/features/register.all": "./.monaco-esm/vs/features/register.all.js",
    "monaco-editor/language/typescript/monaco.contribution": "./.monaco-esm/vs/language/typescript/monaco.contribution.js",
    "monaco-editor/language/css/monaco.contribution": "./.monaco-esm/vs/language/css/monaco.contribution.js",
    "monaco-editor/language/typescript/ts.worker": "./.monaco-esm/vs/language/typescript/ts.worker.js",
    "monaco-editor/language/css/css.worker": "./.monaco-esm/vs/language/css/css.worker.js"
  },
  "tasks": {
    "check": "deno check packages",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "monaco-esm": "deno run -A packages/tools/monaco-esm.ts",
    "build": "deno run -A packages/tools/build.ts",
    "build:firefox": "deno run -A packages/tools/build.ts --browser firefox",
    "build:chrome": "deno run -A packages/tools/build.ts --browser chrome",
    "watch:firefox": "deno run -A --watch=packages tools/build.ts --browser firefox",
    "devserver": "deno run -A packages/tools/dev_server.ts --dir examples",
    "run:zen": "deno run -A packages/tools/launch.ts --browser zen",
    "lint:ext": "deno run -A packages/tools/build.ts --browser firefox && deno run -A npm:web-ext@10.6.0 lint --source-dir dist/firefox",
    "zip:firefox": "deno run -A packages/tools/build.ts --browser firefox --zip",
    "zip:chrome": "deno run -A packages/tools/build.ts --browser chrome --zip",
    "build:safari": "deno run -A packages/tools/build.ts --browser safari",
    "swift:fmt": "swift format format --recursive --in-place apple",
    "swift:lint": "swift format lint --recursive --strict apple",
    "unused": "deno run -A packages/tools/unused.ts",
    "run": "deno run -A packages/tools/launch.ts"
  },
  "workspace": [
    "packages/shared",
    "packages/protocol",
    "packages/background",
    "packages/content",
    "packages/inject",
    "packages/ui",
    "packages/tools",
    "packages/tests"
  ]
}
